# GreenPulse Frontend Environment Variables
# In local development, the frontend will target the local backend runner or fallback gracefully to client-side mock service.
# For local backend server:
VITE_API_BASE_URL=http://localhost:3000

# When deployed to AWS, replace with your API Gateway endpoint:
# VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod
