# GreenPulse Backend Environment Variables
PORT=3000
NODE_ENV=development

# AWS Configuration (when deploying to AWS or connecting to real AWS DynamoDB)
# During local development, leaving these unset will automatically use the built-in in-memory mock store
# so that the local API works immediately without any AWS credentials or local DynamoDB installation.
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=GreenhouseReadings

# Optional: For local DynamoDB container if used
# DYNAMODB_ENDPOINT=http://localhost:8000
